{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/check.sh\" session-start cursor",
        "timeout": 60
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT}/hooks/check.sh\" stop cursor",
        "timeout": 600,
        "loop_limit": 5
      }
    ]
  }
}
